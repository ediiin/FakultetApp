<UserControl x:Class="FakultetApp.Views.AsistentViews.AsistentChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FakultetApp.Views.AsistentViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Stil za balončić poruke (Lijevo vs Desno) -->
        <Style x:Key="BubbleBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource IncomingBubble}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMojaPoruka}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="{DynamicResource ButtonColor}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stil za tekst unutar balončića -->
        <Style x:Key="BubbleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMojaPoruka}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stil za vrijeme slanja poruke -->
        <Style x:Key="BubbleTimeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMojaPoruka}" Value="True">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <!-- Lijeva strana: 30% -->
            <ColumnDefinition Width="3*" MinWidth="280"/>
            <!-- Desna strana: 70% -->
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LIJEVA STRANA (30%): PRETRAGA I LISTA CHATOVA -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" Background="{DynamicResource CardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Border Grid.Row="0" Padding="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBox x:Name="txtPretraga" Height="36" Padding="10,6" FontSize="13" 
                                 TextChanged="TxtPretraga_TextChanged" 
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource BorderColor}"/>

                        <!-- TextBlock Placeholder -->
                        <TextBlock Text="🔍 Pretraži (ime, prezime, indeks)..." 
                                   IsHitTestVisible="False" 
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center" 
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtPretraga}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Lista Razgovora -->
                <ListBox x:Name="lstRazgovori" Grid.Row="1" 
                         SelectionChanged="LstRazgovori_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar Krug -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ButtonColor}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Inicijali}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Ime i Posljednja poruka -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ImePrezime}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UlogaIliIndeks}" FontSize="11" Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="{Binding PosljednjaPoruka}" FontSize="12" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Vrijeme i Nepročitano -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding VrijemePosljednjePoruke, StringFormat={}{0:HH:mm}}" FontSize="11" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                                    <!-- Badge za nepročitane poruke -->
                                    <Border Background="{DynamicResource UnreadBadge}" CornerRadius="9" MinWidth="18" Height="18" Margin="0,4,0,0" HorizontalAlignment="Right" Padding="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BrojNeprocitanih}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BrojNeprocitanih}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- DESNA STRANA (70%): OTVORENI CHAT ILI EMPTY STATE -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1">

            <!-- A) EMPTY STATE (Kada nije odabran nijedan razgovor) -->
            <Grid x:Name="PrikazPrazno" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💬" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5"/>
                    <TextBlock Text="Vaše poruke" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Naslov}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Odaberite razgovor s lijeve strane ili pretražite studente i kolege." 
                               FontSize="13" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- B) AKTIVNI CHAT PANEL -->
            <Grid x:Name="PrikazAktivniChat" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Zaglavlje Chata -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource ButtonColor}" Margin="0,0,10,0">
                            <TextBlock x:Name="txtZaglavljeInicijali" Text="?" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtZaglavljeIme" Text="Ime Sagovornika" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Naslov}"/>
                            <TextBlock x:Name="txtZaglavljeUloga" Text="Uloga / Indeks" FontSize="12" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Lista Poruka (Balončići) -->
                <ScrollViewer x:Name="scrollPoruke" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15">
                    <ItemsControl x:Name="icPoruke">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BubbleBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sadrzaj}" Style="{StaticResource BubbleTextStyle}"/>
                                        <TextBlock Text="{Binding VrijemeSlanja, StringFormat={}{0:HH:mm}}" Style="{StaticResource BubbleTimeStyle}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 3. Unos i slanje nove poruke -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtNovaPoruka" Grid.Column="0" 
                                 Height="40" Padding="12,8" FontSize="13" 
                                 TextWrapping="Wrap" VerticalContentAlignment="Center"
                                 AcceptsReturn="False" KeyDown="TxtNovaPoruka_KeyDown"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource PrimaryText}"
                                 BorderBrush="{DynamicResource BorderColor}"/>

                        <Button x:Name="btnPosalji" Grid.Column="1" Click="BtnPosalji_Click"
                                Content="Pošalji ✈️" Margin="10,0,0,0" Padding="18,0" Height="40" 
                                Background="{DynamicResource ButtonColor}" Foreground="White" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>