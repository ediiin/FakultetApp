<UserControl x:Class="FakultetApp.Views.AsistentViews.AsistentObjaveMaterijaliView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Stil za sub-tabove -->
        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" HorizontalAlignment="Center" MaxWidth="900" Width="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Zaglavlje (Filteri) -->
            <RowDefinition Height="Auto"/>
            <!-- Kontrole (Tabovi i Dodaj dugme) -->
            <RowDefinition Height="*"/>
            <!-- Prikaz sadržaja -->
        </Grid.RowDefinitions>

        <!-- 1. ZAGLAVLJE I FILTERI -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Upravljanje Objavama i Materijalima" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="Odaberite predmet kako biste pregledali ili dodali novi sadržaj za studente." FontSize="13" Foreground="{DynamicResource PrimaryText}" Opacity="0.8" Margin="0,5,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Godina studija:" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbGodina" SelectionChanged="CmbGodina_SelectionChanged" Height="35" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Predmet:" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbPredmet" SelectionChanged="CmbPredmet_SelectionChanged" Height="35" FontSize="14" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. NAVIGACIJA UNUTAR TABA -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton x:Name="tabObjave" Content="📢 Objave" Style="{StaticResource SubTabButton}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="tabMaterijali" Content="📁 Materijali" Style="{StaticResource SubTabButton}" Checked="Tab_Checked"/>
            </StackPanel>

            <Button x:Name="btnDodajNovo" Click="BtnDodajNovo_Click" Content="➕ Dodaj objavu" HorizontalAlignment="Right" Padding="15,0" Height="35" Background="{DynamicResource AccentColor}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 3. PRIKAZ SADRŽAJA (Zavisno šta je kliknuto) -->
        <Grid Grid.Row="2">

            <!-- A) LISTA OBJAVA -->
            <Grid x:Name="PrikazObjava" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtNemaObjava" Text="Nema objava za ovaj predmet." Foreground="{DynamicResource PrimaryText}" FontSize="15" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="icObjave">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Naslov}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                            <TextBlock Text="{Binding DatumObjave, StringFormat={}{0:dd.MM.yyyy. HH:mm}}" FontSize="11" Foreground="{DynamicResource PrimaryText}" Opacity="0.7" Margin="0,2,0,8"/>
                                            <TextBlock Text="{Binding Sadrzaj}" FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Paginacija za objave -->
                        <StackPanel x:Name="PanelPaginacijaObjava" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- B) LISTA MATERIJALA -->
            <Grid x:Name="PrikazMaterijala" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtNemaMaterijala" Text="Nema materijala za ovaj predmet." Foreground="{DynamicResource PrimaryText}" FontSize="15" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="icMaterijali">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                                        <Grid>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ikona}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding TipMaterijala}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Naslov}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,5"/>
                                                <TextBlock Text="{Binding DatumObjave, StringFormat={}{0:dd.MM.yyyy. HH:mm}}" FontSize="11" Foreground="{DynamicResource PrimaryText}" Opacity="0.7"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Paginacija za materijale -->
                        <StackPanel x:Name="PanelPaginacijaMaterijala" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- C) UNOS NOVE OBJAVE -->
            <Grid x:Name="UnosObjave" Visibility="Collapsed" Background="{DynamicResource CardBackground}" Margin="0,0,0,10">
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Kreiranje nove objave" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,20"/>

                            <TextBlock Text="Naslov objave:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNoviNaslovObjave" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                            <TextBlock Text="Sadržaj objave:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNoviSadrzajObjave" Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                            <!-- Vidljivost objave (Globalna ili lokalna) -->
                            <TextBlock Text="Vidljivost:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkGlobalnaObjava" Content="Ovo je globalna objava (vidljivo svima, ne vezuje se za predmet)" 
                               Foreground="{DynamicResource PrimaryText}" FontSize="13" Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Odustani" Click="BtnOdustani_Click" Background="Transparent" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="Objavi" Click="BtnSpasiObjavu_Click" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Padding="25,8" Cursor="Hand" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- D) UNOS NOVOG MATERIJALA -->
            <Grid x:Name="UnosMaterijala" Visibility="Collapsed" Background="{DynamicResource CardBackground}" Margin="0,0,0,10">
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5" Text="Naslov materijala:"/>
                        <TextBox FontSize="14" Height="35" Margin="0,0,0,15" Padding="5" x:Name="txtNoviNaslovMaterijala"/>

                        <!-- Dodali smo Opis iz tvog Modela -->
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5" Text="Opis (opciono):"/>
                        <TextBox AcceptsReturn="True" FontSize="14" Height="60" Margin="0,0,0,15" Padding="5" TextWrapping="Wrap" x:Name="txtNoviOpisMaterijala"/>

                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5" Text="Tip materijala:"/>
                        <!-- Dodat SelectionChanged event -->
                        <ComboBox FontSize="14" Height="35" Margin="0,0,0,15" SelectionChanged="CmbTipMaterijala_SelectionChanged" x:Name="cmbTipMaterijala">
                            <ComboBoxItem Content="PDF" IsSelected="True"/>
                            <ComboBoxItem Content="Skripta (Word)"/>
                            <ComboBoxItem Content="Video"/>
                        </ComboBox>

                        <!-- PANEL ZA FAJL (Prikazuje se za PDF/Word) -->
                        <StackPanel Visibility="Visible" x:Name="PanelFajl">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5" Text="Odabir fajla:"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox FontSize="14" Grid.Column="0" Height="35" IsReadOnly="True" Margin="0,0,10,0" Padding="5" x:Name="txtPutanjaMaterijala"/>
                                <Button Click="BtnOdaberiFajl_Click" Content="📁 Odaberi fajl" Cursor="Hand" Grid.Column="1" Padding="15,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- PANEL ZA LINK (Prikazuje se samo kad je odabran Video) -->
                        <StackPanel Margin="0,0,0,20" Visibility="Collapsed" x:Name="PanelLink">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5" Text="Unesite Web Link (npr. YouTube URL):"/>
                            <TextBox FontSize="14" Height="35" Padding="5" x:Name="txtVideoLink"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Click="BtnOdustani_Click" Content="Odustani" Cursor="Hand" Foreground="{DynamicResource PrimaryText}" Margin="0,0,10,0" Padding="15,8"/>
                            <Button Background="{DynamicResource AccentColor}" BorderThickness="0" Click="BtnSpasiMaterijal_Click" Content="Spasi materijal" Cursor="Hand" FontWeight="Bold" Foreground="White" Padding="25,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>