<UserControl x:Class="FakultetApp.Views.AsistentView.AsistentPocetnaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Zaglavlje -->
            <RowDefinition Height="Auto"/>
            <!-- Kartice -->
            <RowDefinition Height="*"/>
            <!-- Brze akcije / Prazan prostor -->
        </Grid.RowDefinitions>

        <!-- 1. ZAGLAVLJE -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock x:Name="txtPozdrav" Text="Dobro došli, Ime Prezime!" 
                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Naslov}" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtDatum" Text="Danas je četvrtak, 15. maj 2026." 
                       FontSize="14" Foreground="{DynamicResource DisabledText}"/>
        </StackPanel>

        <!-- 2. INFO KARTICE -->
        <Grid Grid.Row="1" Margin="0,0,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- Razmak -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- Razmak -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kartica 1: Moji predmeti -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Moji predmeti" Foreground="{DynamicResource DisabledText}" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtBrojPredmeta" Text="0" Foreground="{DynamicResource PrimaryText}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Kartica 2: Ukupno studenata -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Ukupno studenata" Foreground="{DynamicResource DisabledText}" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtBrojStudenata" Text="0" Foreground="{DynamicResource PrimaryText}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Kartica 3: Neocijenjeni (ili neka druga brza info) -->
            <Border Grid.Column="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Prosječna prolaznost" Foreground="{DynamicResource DisabledText}" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtProlaznost" Text="-%" Foreground="{DynamicResource Naslov}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>