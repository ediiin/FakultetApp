<UserControl x:Class="FakultetApp.Views.StudentViews.StudentiZahtjeviZaPotvrduView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource WindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Forma za novi zahtjev -->
            <RowDefinition Height="*"/>
            <!-- Lista zahtjeva -->
        </Grid.RowDefinitions>

        <!-- KARTICA: PODNESI NOVI ZAHTJEV -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Podnesi novi zahtjev za potvrdu" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryText}" 
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Svrha -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Svrha potvrde:" 
                                   Foreground="{DynamicResource PrimaryText}" 
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSvrha" 
                                  Height="35" 
                                  FontSize="14" 
                                  Padding="8,5" />
                    </StackPanel>

                    <!-- Napomena -->
                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Napomena (opcionalno):" 
                                   Foreground="{DynamicResource PrimaryText}" 
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNapomena" 
                                 Height="35" 
                                 FontSize="14" 
                                 Padding="8,5" 
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource PrimaryText}"
                                 ToolTip="Npr. naziv opštine za stipendiju"/>
                    </StackPanel>

                    <!-- Dugme za podnošenje -->
                    <Button Grid.Column="2" 
                            x:Name="btnPodnesi" 
                            Content="Podnesi zahtjev" 
                            Background="{DynamicResource ButtonColor}" 
                            Foreground="{DynamicResource PrimaryText}" 
                            FontWeight="Bold" 
                            Height="35" 
                            Width="140" 
                            Margin="0,21,0,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnPodnesi_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- KARTICA: HISTORIJA ZAHTJEVA -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Moji zahtjevi" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource Naslov}" 
                           Margin="0,0,0,15"/>

                <ListView x:Name="lstZahtjevi" 
                          Grid.Row="1" 
                          Background="Transparent"
                          BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}" 
                                    BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kolona 1: Svrha i Datum -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SvrhaText}" 
                               FontWeight="Bold" 
                               FontSize="15" 
                               Foreground="{DynamicResource PrimaryText}" 
                               Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding DatumPodnosenjaText}" 
                               Foreground="{DynamicResource DisabledText}" 
                               FontSize="12"/>
                                    </StackPanel>

                                    <!-- Kolona 2: Napomena -->
                                    <TextBlock Grid.Column="1" 
                           Text="{Binding Napomena}" 
                           TextWrapping="Wrap" 
                           Foreground="{DynamicResource PrimaryText}" 
                           VerticalAlignment="Center" 
                           Margin="10,0"/>

                                    <!-- Kolona 3: Status Badge -->
                                    <Border Grid.Column="2" 
                        Background="{Binding StatusBojaPozadina}" 
                        CornerRadius="12" 
                        Padding="10,5" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" 
                               Foreground="{Binding StatusBojaTekst}" 
                               FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Kolona 4: Akcija (Poništi) -->
                                    <Button Grid.Column="3" 
                        Content="✖ Poništi" 
                        Foreground="{DynamicResource Error}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        FontWeight="Bold"
                        HorizontalAlignment="Right"
                        Visibility="{Binding PrikaziDugmePonisti}"
                        Click="BtnPonisti_Click" 
                        Tag="{Binding Id}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>