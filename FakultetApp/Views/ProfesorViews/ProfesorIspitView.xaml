<UserControl x:Class="FakultetApp.Views.ProfesorViews.ProfesorIspitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{DynamicResource WindowBackground}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <Border Background="{DynamicResource CardBackground}" Width="550" HorizontalAlignment="Center" VerticalAlignment="Top" 
                    CornerRadius="10" Padding="40" Margin="20,40,20,40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Button x:Name="btnNazad" Content="← Nazad" Click="BtnNazad_Click" Width="90" Height="35" 
                            Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                            BorderBrush="{DynamicResource PrimaryText}" Cursor="Hand" Margin="0,0,20,0"
                            Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="Zakazivanje novog ispita" FontSize="26" FontWeight="Bold" 
                            Foreground="{DynamicResource Naslov}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Predmet -->
                    <TextBlock Text="Predmet:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbMojiPredmeti" Height="38" DisplayMemberPath="Naziv" FontSize="14" 
                              Padding="5" Margin="0,0,0,2"/>
                    <TextBlock x:Name="lblPredmetError" Text="Molimo odaberite predmet." 
                               Foreground="{DynamicResource Error}" FontSize="12" Margin="0,0,0,12" Visibility="Hidden"/>

                    <!-- Datum održavanja -->
                    <TextBlock Text="Datum održavanja:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dtpDatumOdrzavanja" Height="38" FontSize="14" Padding="5" Margin="0,0,0,2"/>
                    <TextBlock x:Name="lblDatumError" Text="Molimo odaberite datum održavanja." 
                               Foreground="{DynamicResource Error}" FontSize="12" Margin="0,0,0,12" Visibility="Hidden"/>

                    <!-- Vrijeme -->
                    <TextBlock Text="Vrijeme (HH:mm):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="tbVrijeme" Height="38" Padding="10,0" VerticalContentAlignment="Center" 
                             FontSize="14" Text="10:00" Margin="0,0,0,2"/>
                    <TextBlock x:Name="lblVrijemeError" Text="Vrijeme nije u ispravnom formatu. Koristite HH:mm." 
                               Foreground="{DynamicResource Error}" FontSize="12" Margin="0,0,0,12" Visibility="Hidden"/>

                    <!-- Broj zadataka -->
                    <TextBlock Text="Broj zadataka:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="tbBrojZadataka" Height="38" Padding="10,0" VerticalContentAlignment="Center" 
                             FontSize="14" Margin="0,0,0,2"/>
                    <TextBlock x:Name="lblBrojZadatakaError" Text="Unesite validan pozitivan broj." 
                               Foreground="{DynamicResource Error}" FontSize="12" Margin="0,0,0,12" Visibility="Hidden"/>

                    <!-- Maksimalan broj bodova -->
                    <TextBlock Text="Maksimalan broj bodova:" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="tbMaxBodova" Height="38" Padding="10,0" VerticalContentAlignment="Center" 
                             FontSize="14" Margin="0,0,0,2"/>
                    <TextBlock x:Name="lblMaxBodovaError" Text="Unesite validan pozitivan broj." 
                               Foreground="{DynamicResource Error}" FontSize="12" Margin="0,0,0,25" Visibility="Hidden"/>

                    <!-- Dodatni rok CheckBox -->
                    <CheckBox x:Name="cbDodatniRok" Content="Ovo je dodatni rok (Cijena prijave 80 KM)" 
                              FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" 
                              FontSize="14" Margin="0,0,0,25" Cursor="Hand"/>
                    
                    <!-- Dugme za potvrdu -->
                    <Button Content="Zakaži ispit" Height="45" Background="{DynamicResource ButtonColor}" Foreground="White" 
                            FontWeight="Bold" FontSize="16" Cursor="Hand" Click="BtnZakaziIspit_Click" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>