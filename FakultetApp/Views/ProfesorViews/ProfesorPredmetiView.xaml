<UserControl x:Class="FakultetApp.Views.ProfesorViews.ProfesorPredmetiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource WindowBackground}">

    <!-- DODAN SCROLLVIEWER DA SE SVE MOŽE SKROLATI -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- GORNJA KARTICA: ODABIR PREDMETA I INFO -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackground}" 
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MinWidth="300">
                        <TextBlock Text="Odaberite predmet:" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbMojiPredmeti" Height="35" FontSize="14" Padding="8,5" FontWeight="Bold"
                                  Foreground="{DynamicResource PrimaryText}" DisplayMemberPath="Naziv"
                                  SelectionChanged="CmbMojiPredmeti_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,30,0" VerticalAlignment="Center">
                            <TextBlock Text="Bodovna vrijednost" Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedItem.ECTS, ElementName=cmbMojiPredmeti, StringFormat={}{0} ECTS}" 
                                       Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,30,0" VerticalAlignment="Center">
                            <TextBlock Text="Godina studija" Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                            <!-- Dinamički prikaz godine studija -->
                            <TextBlock Text="{Binding SelectedItem.GodinaStudija.Naziv, ElementName=cmbMojiPredmeti}" 
                                       Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Upisanih studenata" Foreground="{DynamicResource DisabledText}" FontSize="12"/>
                            <!-- DODANO IME DA SE MOŽE MIJENJATI IZ KODA -->
                            <TextBlock x:Name="txtBrojUpisanih" Text="0" 
                                       Foreground="{DynamicResource Naslov}" FontWeight="Bold" FontSize="18" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DONJI DIO: DVIJE KOLONE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <!-- LIJEVA KARTICA: SPISAK STUDENATA -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Konačne ocjene i bodovi studenata" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,15"/>
                        <TextBox Grid.Row="1" x:Name="txtPretragaStudenata" Height="35" FontSize="14" Padding="8,5" Margin="0,0,0,15"
                                 Foreground="{DynamicResource PrimaryText}" Text="🔍 Pretraga studenata..."
                                 TextChanged="TxtPretragaStudenata_TextChanged"/>

                        <!-- Postavljen fiksni MinHeight zbog ScrollViewera vani -->
                        <ListView x:Name="lstStudenti" Grid.Row="2" Background="Transparent" BorderThickness="0" MinHeight="350">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderColor}" 
                                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- POPRAVLJENI BINDINGI: Indeks, Ime i Prezime -->
                                            <TextBlock Grid.Column="0" Text="{Binding Student.Indeks}" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center">
                                                <Run Text="{Binding Student.Ime}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Student.Prezime}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="2" Text="{Binding BrojBodova, StringFormat={}{0} bod.}" Foreground="{DynamicResource DisabledText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Ocjena}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>

                                            <Border Grid.Column="4" Background="{DynamicResource IncomingBubble}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Polozio}" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- DESNA KOLONA: AKCIJE I DETALJI -->
                <StackPanel Grid.Column="1">

                    <!-- KARTICA 1: BRZE AKCIJE -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Brze akcije" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Naslov}" Margin="0,0,0,15"/>

                            <!-- DODANI CLICK EVENTI -->
                            <Button Content="📝 Unos konačnih ocjena" 
                                    Click="BtnUnosOcjena_Click"
                                    Background="{DynamicResource ButtonColor}" Foreground="{DynamicResource PrimaryText}" 
                                    FontWeight="Bold" Height="35" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"/>

                            <Button Content="📅 Zakaži novi ispit" 
                                    Click="BtnZakaziIspit_Click"
                                    Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" FontWeight="SemiBold" Height="35" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- KARTICA 2: PRAVILA BODOVANJA -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Pravila bodovanja (Podsjetnik)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" x:Name="txtPravilaBodovanja" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" 
                                     CaretBrush="{DynamicResource PrimaryText}" Padding="10" Margin="0,0,0,10" MinHeight="120"/>
                            <Button Grid.Row="2" Content="💾 Sačuvaj podsjetnik" Click="BtnSacuvajBodovanje_Click"
                                    Background="{DynamicResource IncomingBubble}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" BorderThickness="0" Height="35" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- KARTICA 3: ANALITIKA -->
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Analitika predmeta" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Prosječna ocjena:" Foreground="{DynamicResource DisabledText}" VerticalAlignment="Center"/>
                                <!-- DODANO IME DA SE KASNIJE MOŽE MIJENJATI -->
                                <TextBlock x:Name="txtProsjecnaOcjena" Text="-" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Ukupna prolaznost:" Foreground="{DynamicResource DisabledText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtProlaznost" Text="-%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Naslov}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>