<UserControl x:Class="FakultetApp.Views.ProfesorViews.ProfesorUnosOcjenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource WindowBackground}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Zaglavlje -->
            <RowDefinition Height="Auto"/>
            <!-- Kaskadni filteri -->
            <RowDefinition Height="*"/>
            <!-- Tabela preko čitave preostale visine/širine -->
        </Grid.RowDefinitions>

        <!-- 1. ZAGLAVLJE -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="← Nazad" Click="BtnNazad_Click" Width="90" Height="35" 
                    Background="Transparent" Foreground="{DynamicResource PrimaryText}" 
                    BorderBrush="{DynamicResource PrimaryText}" Cursor="Hand" Margin="0,0,20,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="Unos ocjena za ispite" FontSize="26" FontWeight="Bold" 
                       Foreground="{DynamicResource Naslov}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 2. KASKADNI FILTERI (DVA COMBOBOX-A) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,20">
            <!-- 1. PRVI COMBOBOX: PREDMETI -->
            <StackPanel Margin="0,0,25,10">
                <TextBlock Text="1. Odaberite predmet:" FontSize="13" FontWeight="SemiBold" 
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbPredmeti" Width="320" Height="35" 
                          DisplayMemberPath="Naziv" SelectedValuePath="Id"
                          SelectionChanged="CmbPredmeti_SelectionChanged" FontSize="14"/>
            </StackPanel>

            <!-- 2. DRUGI COMBOBOX: ISPITI/DATUMI ZA TAJ PREDMET -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="2. Odaberite rok / datum:" FontSize="13" FontWeight="SemiBold" 
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbIspiti" Width="380" Height="35" 
                          DisplayMemberPath="PrikazTekst" SelectedValuePath="IspitId"
                          SelectionChanged="CmbIspiti_SelectionChanged" FontSize="14"/>
            </StackPanel>
        </WrapPanel>

        <!-- 3. TABELA KOJA POKRIVA ČITAV PREOSTALI PROSTOR -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15" HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>

            <Grid HorizontalAlignment="Stretch">
                <DataGrid x:Name="dgPrijave" AutoGenerateColumns="False" IsReadOnly="False" 
          SelectionMode="Single" Background="Transparent" BorderThickness="0"
          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
          RowBackground="{DynamicResource CardBackground}"
          AlternatingRowBackground="{DynamicResource WindowBackground}"
          Foreground="{DynamicResource PrimaryText}" CanUserAddRows="False"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <DataGrid.Columns>

                        <!-- 1. VIZUELNI INDIKATOR / STATUS BADGE -->
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusPozadina}" 
                            BorderBrush="{Binding StatusBoja}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="10,4" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusTekst}" 
                                   Foreground="{Binding StatusBoja}" 
                                   FontWeight="Bold" 
                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. OSTALE KOLONE -->
                        <DataGridTextColumn Header="Student (Ime i prezime)" Binding="{Binding ImePrezime}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Broj indeksa" Binding="{Binding Indeks}" Width="1*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Izlazak" Binding="{Binding BrojIzlazaka}" Width="80" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="Ocjena" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DostupneOcjene}" 
                              SelectedItem="{Binding OdabranaOcjena, UpdateSourceTrigger=PropertyChanged}" 
                              Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Akcija" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sačuvaj" Background="#28a745" Foreground="White" 
                            FontWeight="Bold" Padding="12,5" Cursor="Hand" BorderThickness="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Click="BtnSacuvajOcjenu_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="lblNemaPrijava" Text="Nema održanih ispita ili prijavljenih studenata za odabrane parametre." 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" 
                           Foreground="{DynamicResource PrimaryText}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>